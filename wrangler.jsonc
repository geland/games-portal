{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gregeland-games",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/play/*",
      "/download/*",
      "/tracker"
    ]
  },
  "r2_buckets": [
    {
      "binding": "GAME_RELEASES",
      "bucket_name": "gregeland-games-releases"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE": "https://play.games.gregeland.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
